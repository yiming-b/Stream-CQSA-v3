# --- build artifacts (the extension is compiled per-GPU by the user) ---
build/
dist/
*.egg-info/
*.so
*.o
*.ninja*
.ninja_deps
.ninja_log

# --- python ---
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
venv/
.venv/

# --- experiment scratch (results/ IS tracked; run outputs are not) ---
outputs/
*.log
slurm-*.out

# OOC-rivals fp64 gradient references (24 GB, regenerable by experiments/ooc_rivals/bench.py)
results/ooc_rivals/grad_ref/

# U1: build logs and the nvcc -time csv of the v13 kernel builds (kernels/v13/build/ and *.so are ignored above)
kernels/v13/logs/

# kernel variant build trees (torch extension objects per kernel set)
kernels/*/build_*/

# v3 harness smoke runs on vis1 (plumbing checks, never measurements): experiments/v3/bench.py --smoke
.smoke/
