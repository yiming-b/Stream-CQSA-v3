+    int device;
+    C10_CUDA_CHECK(cudaGetDevice(&device));
+    int max_smem_per_block;
+    C10_CUDA_CHECK(cudaDeviceGetAttribute(&max_smem_per_block, cudaDevAttrMaxSharedMemoryPerBlockOptin, device));
